# Copy to .env and fill with your secrets — never commit .env
# Reference: docs/architecture.md §3.4, §3.6, §8

# Shuffle webhook receiving Wazuh alerts (Manager integration hook_url)
# Example: https://shuffler.io/api/v1/hooks/<uuid>
WAZUH_SHUFFLE_HOOK_URL=https://shuffler.io/api/v1/hooks/WEBHOOK_ID_PLACEHOLDER

# Shuffle SOAR environment secrets (used by playbook-export.json)
ABUSEIPDB_API_KEY=your_abuseipdb_api_key_here
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/xxx/yyy
TARGET_HOST=192.168.56.20
ALLOWLISTED_IPS=192.168.56.1,192.168.56.10

# Optional: Shuffle SSH app credential for blocking (store as Shuffle auth, not here)
# SHUFFLE_SSH_HOST, SHUFFLE_SSH_USER, SHUFFLE_SSH_KEY_ID are configured in Shuffle UI
