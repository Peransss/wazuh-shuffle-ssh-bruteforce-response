<!--
  Custom Wazuh rules for SSH brute force detection.
  Install: copy to /var/ossec/etc/rules/local_rules.xml on the Manager and run `wazuh-control test config && systemctl restart wazuh-manager`
  Reference: docs/architecture.md §3.2 and §5
-->
<group name="ssh_brute_force,">
  <!-- Trigger on 5 failed passwords from same IP in 60s (sensitive for lab; use 10/120 in production) -->
  <rule id="100200" level="10" frequency="5" timeframe="60">
    <if_matched_sid>5712</if_matched_sid>
    <same_source_ip />
    <description>SSH brute force: 5 failed passwords from same IP in 60s</description>
    <group>authentication_failures,attack,</group>
    <mitre><id>T1110.001</id></mitre>
  </rule>

  <!-- Escalation: 10 fails in 120s → higher severity, still triggers Shuffle (level >=10) -->
  <rule id="100201" level="12" frequency="10" timeframe="120">
    <if_matched_sid>5712</if_matched_sid>
    <same_source_ip />
    <description>SSH brute force escalated: 10 fails in 120s</description>
    <group>authentication_failures,attack,</group>
    <mitre><id>T1110.001</id></mitre>
  </rule>
</group>
